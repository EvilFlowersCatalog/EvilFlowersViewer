{
  "name": "@evilflowers/evilflowersviewer",
  "version": "0.7.9",
  "description": "Document-centric PDF reader for the browser (Vue 3 + pdf.js), embeddable in any host application.",
  "main": "dist/evilFlowersViewer.umd.js",
  "module": "dist/evilFlowersViewer.es.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EvilFlowersCatalog/EvilFlowersViewer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit --skipLibCheck -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build-only"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@citation-js/plugin-ris": "^0.7.21",
    "@fontsource-variable/inter": "^5.3.0",
    "@vue/devtools-api": "^8.2.1",
    "dompurify": "^3.4.18",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "pinia": "^4.1.0",
    "print-js": "^1.6.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/language-core": "^3.3.14",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
